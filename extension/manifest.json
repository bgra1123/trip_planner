{
  "manifest_version": 3,
  "name": "TripAgent Capture",
  "version": "0.3.0",
  "description": "Capture flight, train and hotel prices from any page — right-click a price, or click Capture on whatever site you have open. Sends them to your Trip Planner.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://bgra1123.github.io/trip_planner/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TripAgent Capture"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/travel/flights*",
        "https://www.google.*/travel/flights*",
        "https://www.kayak.com/flights/*",
        "https://www.kayak.*/flights/*",
        "https://www.skyscanner.net/transport/flights/*",
        "https://www.skyscanner.*/transport/flights/*",
        "https://www.booking.com/searchresults*",
        "https://www.booking.com/hotel/*",
        "https://www.trainline.com/*",
        "https://int.bahn.de/*",
        "https://www.thetrainline.com/*",
        "https://travel.capitalone.com/*",
        "https://travel.americanexpress.com/*"
      ],
      "js": [
        "scrapers.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://bgra1123.github.io/trip_planner/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
